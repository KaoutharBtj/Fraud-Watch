# ─────────────────────────────────────────────────────────────────────────────
# Database — used by database.py (pipeline) and api/db.py (dashboard), same DB
# ─────────────────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fraud_db
DB_USER=postgres
DB_PASSWORD=postgres

# ─────────────────────────────────────────────────────────────────────────────
# Kafka — used by main.py (consumer) and simulator_server.py (producer)
# ─────────────────────────────────────────────────────────────────────────────
KAFKA_BROKER=localhost:9092
TRANSACTION_TOPIC=transactions

# Profile API — simulator_server.py's own address, called by ingestor_agent.py
PROFILE_API=http://localhost:8000

# Ollama LLM — used by llm_reasoner_agent.py and chat_agent.py
OLLAMA_MODEL=qwen3:8b

# ─────────────────────────────────────────────────────────────────────────────
# Fraud decision thresholds — used by llm_reasoner_agent.py / ML_model.py
# Score is 0-100 (higher = more anomalous)
# ─────────────────────────────────────────────────────────────────────────────
BLOCK_THRESHOLD=80
REVIEW_THRESHOLD=40

# ─────────────────────────────────────────────────────────────────────────────
# Dashboard API service — used by api/main.py (NEW, separate from simulator)
# ─────────────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8001
